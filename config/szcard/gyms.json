  "start": [
    "op: pokeheal",
    "wait: 1",
    "console: mv clone personalmap {player}-gym",
    "console: mvtp {player} {player}-gym --unsafe"
  ],
  "battle": [
    "op: 워프 이동 개인체육관{n}",
    "wait: 40",
    "console: execute at {player} run tbcs attach rctmod:{trainer} @e[name=\"{mob}\",distance=..30,limit=1]",
    "wait: 10",
    "op: 보정배틀 {battleLevel} GEN_9_SINGLES @p vs @e[name=\"{mob}\",distance=..30,limit=1] onwin {1:['체육관승리 {n} {player}'], 2:['체육관패배 {n} {player}']}"
  ],
  "win": [
    "wait: 8",
    "op: 워프 이동 체육관{n}",
    "console: mv remove {player}-gym --remove-players",
    "console: 월드폴더삭제 {player}-gym",
    "wait: 60",
    "badge",
    "op: 아이템가져오기 {badge} 1",
    "message:  <#ABEBFF>[<#9AE8FD>C<#88E4FB>o<#77E1F8>b<#65DDF6>b<#54DAF4>l<#54C1E8>e<#54A8DB>m<#5490CF>o<#5477C2>n<#545EB6>] <#A7E8FC>{badge}<#E1F1F6>를 획득했습니다.",
    "op: 레벨캡설정 {player} {cap}",
    "wait: 20",
    "sound: creepy 0.5 1",
    "totem"
  ],
  "lose": [
    "wait: 8",
    "op: 워프 이동 체육관{n}",
    "console: mv remove {player}-gym --remove-players",
    "console: 월드폴더삭제 {player}-gym"
  ],
  "exit": [
    "op: 워프 이동 체육관{n}",
    "op: stopbattle @p",
    "console: mv remove {player}-gym --remove-players",
    "console: 월드폴더삭제 {player}-gym"
  ],
  "exitBlocks": [
    "minecraft:coal_block",
    "minecraft:iron_block",
